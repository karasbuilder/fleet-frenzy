{
  "name": "fleet-frenzy",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet Frenzy \u2014 classic 10x10 Battleship vs bot, built with Phaser 4 for UTXOPlay",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=./ && node tools/precompress.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tools/review-browser.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
